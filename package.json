{
  "name": "dsh-sim-folder",
  "version": "0.1.1",
  "type": "module",
  "description": "会话文件夹：在 DSH 侧边栏用文件夹整理会话，仅本地映射，不改 DSH 会话数据。",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "sessions",
        "workspaces",
        "layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jediliu005/dsh-sim-folder.git"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "session",
    "folders",
    "sidebar",
    "ui"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ]
}
